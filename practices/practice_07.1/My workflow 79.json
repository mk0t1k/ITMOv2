    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(raw);\nconst commitId = $(\"Get file's PR info\").first().json.head.sha;\n\nconst validComments = (parsed.comments || [])\n  .filter(c => c.path && Number.isInteger(c.line) && c.line > 0)\n  .map(c => ({\n    path: c.path,\n    line: c.line,\n    side: 'RIGHT',\n    body: c.body\n  }));\n\nreturn [{\n  json: {\n    commit_id: commitId,\n    body: parsed.summary || 'AI Code Review завершено',\n    event: 'COMMENT',\n    comments: validComments\n  }\n}];"
      },
