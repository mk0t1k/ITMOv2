      "parameters": {
        "promptType": "define",
        "text": "=Сделай code review измененных строк в diff. Ориентируйся строго на метки [Line X] (не указывай строки с [DEL]).\nВерни ответ СТРОГО в формате чистого JSON без markdown-оберток:\n{\n  \"summary\": \"Общий вывод по PR\",\n  \"comments\": [\n    { \"path\": \"путь/к/файлу\", \"line\": 10, \"body\": \"Суть замечания и вариант исправления\" }\n  ]\n}\n\n{{ $json.diff }}",
        "options": {
          "systemMessage": ""
        }
      },
      "id": "721a3f6f-2a88-47d3-87af-d318c4af686e",
      "name": "Code Review Agent2",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1792,
        -192
      ],
      "typeVersion": 1.9
    },
    {
      "parameters": {
        "jsCode": "const files = $input.all().map(item => item.json);\nconst formatted = files\n  .filter(f => f.patch)\n  .map(f => {\n    let lineNum = 0;\n    const lines = f.patch.split('\\n').map(line => {\n      const match = line.match(/^@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n      if (match) {\n        lineNum = parseInt(match[1], 10);\n        return line;\n      }\n      if (line.startsWith('-')) return `[DEL] ${line}`;\n      if (line.startsWith('+') || line.startsWith(' ')) {\n        const current = lineNum++;\n        return `[Line ${current}] ${line}`;\n      }\n      return line;\n    });\n    return `### File: ${f.filename}\\n${lines.join('\\n')}`;\n  });\n\nreturn [{ json: { diff: formatted.join('\\n\\n') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        -288
      ],
