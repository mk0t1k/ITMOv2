    {
      "parameters": {
        "jsCode": "const current = $('Aggregate Stats').first().json;\nconst rows = $('Get Past Stats').all().map(r => r.json).filter(r => r && r.week_date);\n\nconst prev = rows.length > 0 ? rows[rows.length - 1] : {\n  new_issues: 0,\n  closed_issues: 0,\n  open_backlog: 0,\n  needs_triage: 0,\n  bugs: 0,\n  tasks: 0,\n  features: 0,\n  others: 0\n};\n\nfunction formatDelta(currVal, prevVal) {\n  const c = Number(currVal) || 0;\n  const p = Number(prevVal) || 0;\n  const diff = c - p;\n  if (diff > 0) return `+${diff}`;\n  if (diff < 0) return `${diff}`;\n  return '0';\n}\n\nconst delta = {\n  new_issues: formatDelta(current.new_issues, prev.new_issues),\n  closed_issues: formatDelta(current.closed_issues, prev.closed_issues),\n  open_backlog: formatDelta(current.open_backlog, prev.open_backlog),\n  needs_triage: formatDelta(current.needs_triage, prev.needs_triage),\n  bugs: formatDelta(current.bugs, prev.bugs),\n  tasks: formatDelta(current.tasks, prev.tasks),\n  features: formatDelta(current.features, prev.features),\n  others: formatDelta(current.others, prev.others)\n};\n\nreturn [{\n  json: {\n    current: current,\n    delta: delta\n  }\n}];"
      },
