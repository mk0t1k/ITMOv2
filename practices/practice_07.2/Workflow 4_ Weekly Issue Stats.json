    {
      "parameters": {
        "jsCode": "const rawItems = $('Get Issues Last 7 Days').all().map(i => i.json);\nconst issuesList = Array.isArray(rawItems) ? rawItems.flat() : rawItems;\n\nconst now = new Date();\nconst weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst newIssues = issuesList.filter(item => {\n  if (!item || item.pull_request) return false;\n  if (!item.created_at) return false;\n  return new Date(item.created_at) >= weekAgo;\n});\n\nlet bugs = 0;\nlet tasks = 0;\nlet features = 0;\nlet needsTriage = 0;\nlet others = 0;\n\nconst authorsMap = {};\n\nfor (const issue of newIssues) {\n  const author = issue.user?.login || 'unknown';\n  authorsMap[author] = (authorsMap[author] || 0) + 1;\n\n  const labels = (issue.labels || []).map(l => (typeof l === 'string' ? l : l.name || '').toLowerCase());\n  let categorized = false;\n  if (labels.includes('bug')) {\n    bugs++;\n    categorized = true;\n  }\n  if (labels.includes('task')) {\n    tasks++;\n    categorized = true;\n  }\n  if (labels.includes('feature')) {\n    features++;\n    categorized = true;\n  }\n  if (labels.includes('needs-triage')) {\n    needsTriage++;\n    categorized = true;\n  }\n  if (!categorized) {\n    others++;\n  }\n}\n\nconst closedRes = $('Get Closed Issues Count').first()?.json || {};\nconst closedCount = Number(closedRes.total_count) || 0;\n\nconst openRes = $('Get Open Backlog Count').first()?.json || {};\nconst openBacklog = Number(openRes.total_count) || 0;\n\nconst triageRes = $('Get Needs Triage Count').first()?.json || {};\nconst triageCount = Number(triageRes.total_count) || 0;\n\nconst weekDate = now.toISOString().slice(0, 10);\nconst authorsList = Object.entries(authorsMap).map(([login, count]) => `${login} (${count})`);\n\nreturn [{\n  json: {\n    week_date: weekDate,\n    new_issues: newIssues.length,\n    closed_issues: closedCount,\n    open_backlog: openBacklog,\n    needs_triage: triageCount,\n    bugs: bugs,\n    tasks: tasks,\n    features: features,\n    others: others,\n    authors: authorsList.join(', ') || 'нет новых обращений'\n  }\n}];"
      },
